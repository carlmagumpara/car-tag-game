# Port assigned by the hosting platform (Render/Railway/Fly set this automatically).
PORT=3001

# Comma-separated list of allowed frontend origins. No wildcards.
# On Vercel set this to https://<project>.vercel.app (plus any custom domain)
# as a Vercel environment variable — server/.env is not used there.
CLIENT_ORIGINS=http://localhost:5173

# Optional: maximum concurrent players (default 40, min 2, max 200).
MAX_PLAYERS=40

# Optional tag tuning: contact distance in px (default 38) and grace period
# after a tag in ms (default 1200) to prevent instant tag-backs.
TAG_RADIUS=38
TAG_COOLDOWN_MS=1200
