# Port assigned by the hosting platform (Render/Railway/Fly set this automatically).
PORT=3001

# Comma-separated list of allowed frontend origins. No wildcards.
# On Vercel set this to https://<project>.vercel.app (plus any custom domain)
# as a Vercel environment variable — server/.env is not used there.
CLIENT_ORIGINS=http://localhost:5173

# Optional: maximum concurrent players per room (default 40, min 2, max 200).
MAX_PLAYERS=40

# Optional: maximum simultaneous game rooms (default 200, min 1, max 1000).
# Existing rooms can always be joined, even when the cap is reached.
MAX_ROOMS=200

# Optional tag tuning: contact distance in px (default 38) and grace period
# after a tag in ms (default 5000) — nobody can be tagged during those 5 seconds.
TAG_RADIUS=38
TAG_COOLDOWN_MS=5000

# Optional: length of a scoring round in seconds (default 60, min 5, max 3600).
# The countdown only runs once at least two drivers are ready.
ROUND_SECONDS=60
