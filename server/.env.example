# Port assigned by the hosting platform (Render/Railway/Fly set this automatically).
PORT=3001

# Comma-separated list of allowed frontend origins. No wildcards.
# On Vercel set this to https://<project>.vercel.app (plus any custom domain)
# as a Vercel environment variable — server/.env is not used there.
CLIENT_ORIGINS=http://localhost:5173

# Optional: maximum concurrent players per room (default 40, min 2, max 200).
MAX_PLAYERS=40

# Optional: maximum simultaneous game rooms (default 200, min 1, max 1000).
# Existing rooms can always be joined, even when the cap is reached.
MAX_ROOMS=200

# Optional tag tuning: contact distance in px (default 38) and the global gate
# between transfers in ms (default 1000). One collision passes "it" once.
TAG_RADIUS=38
TAG_COOLDOWN_MS=1000

# Immunity given to the newly tagged driver in ms (default 2000). They cannot
# be tagged during this window but can tag others after TAG_COOLDOWN_MS.
IMMUNITY_MS=2000

# Optional: length of a scoring round in seconds (default 90, min 5, max 3600).
# A round starts automatically once at least two drivers are connected.
ROUND_SECONDS=90

# Optional: the results screen hold (default 2500 ms) and the pre-round
# countdown (default 3000 ms) between rounds.
RESULT_HOLD_MS=2500
COUNTDOWN_MS=3000
