# Frontend (build-time, public values — never put secrets here)
# URL of the Socket.IO multiplayer server. Use https:// in production.
# Leave empty in a Vercel production build to use the same deployment origin.
VITE_GAME_SERVER_URL=http://localhost:3001

# Socket.IO path. Local standalone server uses the default '/socket.io'.
# On Vercel, the function at api/game.js is served at:
VITE_GAME_SOCKET_PATH=/api/game/socket.io

# Socket.IO transports. Vercel Functions only support WebSocket upgrades,
# so use 'websocket' there. Local development can keep polling as a fallback.
VITE_GAME_TRANSPORTS=websocket,polling

# Optional. Set to '/' for a custom-domain root deployment, or './' (default)
# for a GitHub Pages / project-style URL.
VITE_BASE_PATH=./
